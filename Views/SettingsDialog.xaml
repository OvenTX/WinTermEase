<Window x:Class="WinTermEase.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="400" Height="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize"
        Background="{DynamicResource AppPanel2Brush}">

    <Window.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource DarkLabel}"/>
        <Style TargetType="ComboBox"  BasedOn="{StaticResource DarkComboBox}"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Font family -->
            <RowDefinition Height="Auto"/>  <!-- Font size -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>  <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- ── Font family ── -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="终端字体" Margin="0,0,0,4"/>
            <ComboBox x:Name="CbFontFamily" IsEditable="True"/>
        </StackPanel>

        <!-- ── Font size ── -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="终端字号（8–32）" Margin="0,0,0,4"/>
            <ComboBox x:Name="CbFontSize" IsEditable="True" Width="100"
                      HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- ── Buttons ── -->
        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <Button Content="取消" DockPanel.Dock="Right" Width="80"
                    Style="{StaticResource DarkButton}" Click="BtnCancel_Click"/>
            <Button Content="确定" DockPanel.Dock="Right" Width="80" Margin="0,0,8,0"
                    Style="{StaticResource AccentButton}" Click="BtnOk_Click"/>
        </DockPanel>
    </Grid>
</Window>
